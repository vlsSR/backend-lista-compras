[Unit]
Description=Backend Lista de la Compra (Spring Boot)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
# Cambia esta ruta al lugar real donde subas el proyecto en el servidor
WorkingDirectory=/home/TU_USUARIO/backend
ExecStart=/usr/bin/java -jar /home/TU_USUARIO/backend/target/backend-1.0.0.jar
Restart=on-failure
RestartSec=5
# Cambia TU_USUARIO por el usuario real de Ubuntu que ejecuta el servicio
User=TU_USUARIO

[Install]
WantedBy=multi-user.target
